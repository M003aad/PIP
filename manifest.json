{
  "manifest_version": 3,
  "name": "PIP",
  "version": "1.1",
  "description": "Enable Picture-in-Picture for videos",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Toggle PiP"
  },
  "icons": {
    "16": "icons/icon16.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
